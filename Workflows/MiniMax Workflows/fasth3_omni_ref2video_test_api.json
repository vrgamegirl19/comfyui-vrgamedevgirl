{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "fasth3_omniref_8step_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {"title": "FastH3 Omni (8-step, INT8 ConvRot)"}
  },
  "2": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": ["1", 0],
      "shift_video": 12.0,
      "shift_audio": 3.0
    },
    "_meta": {"title": "ModelSamplingMiniMaxH3 (FastH3: video 12, audio 3)"}
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {"title": "Qwen3-VL 32B text encoder (NVFP4, Blackwell)"}
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"},
    "_meta": {"title": "H3 Video VAE"}
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"},
    "_meta": {"title": "H3 Audio VAE"}
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {"image": "ava3.png"},
    "_meta": {"title": "<Picture 1> reference"}
  },
  "7": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["3", 0],
      "vae": ["4", 0],
      "audio_vae": ["5", 0],
      "prompt": "<Picture 1> stands on a neon-lit rooftop at night and sings to the camera with a confident smile, her hair moving in the wind. Medium close-up, slow push in. She sings: \"We light the city when the sky goes dark.\" A synthpop beat with warm bass plays under her voice.",
      "width": 1344,
      "height": 768,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["6", 0]
    },
    "_meta": {"title": "MiniMax H3 Reference to Video"}
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": {"noise_seed": 42},
    "_meta": {"title": "Seed"}
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["2", 0],
      "conditioning": ["7", 0]
    },
    "_meta": {"title": "Guider (CFG 1.0)"}
  },
  "10": {
    "class_type": "KSamplerSelect",
    "inputs": {"sampler_name": "euler"},
    "_meta": {"title": "Sampler"}
  },
  "11": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["2", 0],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    },
    "_meta": {"title": "8 steps"}
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["9", 0],
      "sampler": ["10", 0],
      "sigmas": ["11", 0],
      "latent_image": ["7", 1]
    },
    "_meta": {"title": "Sample"}
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["4", 0]
    },
    "_meta": {"title": "Decode video"}
  },
  "14": {
    "class_type": "LTXVAudioVAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "audio_vae": ["5", 0]
    },
    "_meta": {"title": "Decode audio"}
  },
  "15": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["13", 0],
      "audio": ["14", 0],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "FastH3_Omni_Test",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    },
    "_meta": {"title": "Save MP4"}
  }
}
