{
  "parse": [
    {
      "name": "title, premise, chapters with settings, a non-numeric heading and a Premise line inside a chapter",
      "text": "Title: The Last Train North\nPremise: Mara follows her father's trail.\n\nChapter 1: The Station\nSetting: The Night Train\n\nMara waits on the platform.\nShe checks the watch.\n\nThe train arrives.\n\n## Chapter Two - Home\nSetting: Home\nPremise: not a premise here\n\nThe kitchen is cold.",
      "book": {
        "title": "The Last Train North",
        "premise": "Mara follows her father's trail.",
        "chapters": [
          {
            "id": "ch_1",
            "title": "The Station",
            "setting_id": "setting_the_night_train",
            "paragraphs": [
              "Mara waits on the platform.\nShe checks the watch.",
              "The train arrives."
            ]
          },
          {
            "id": "ch_2",
            "title": "Home",
            "setting_id": "setting_home",
            "paragraphs": [
              "Premise: not a premise here",
              "The kitchen is cold."
            ]
          }
        ]
      },
      "setting_names": {
        "setting_the_night_train": "The Night Train",
        "setting_home": "Home"
      },
      "text_out": "Title: The Last Train North\nPremise: Mara follows her father's trail.\n\nChapter 1: The Station\nSetting: The Night Train\n\nMara waits on the platform.\nShe checks the watch.\n\nThe train arrives.\n\nChapter 2: Home\nSetting: Home\n\nPremise: not a premise here\n\nThe kitchen is cold."
    },
    {
      "name": "text without headings or blank lines is one chapter, one paragraph per line",
      "text": "one line\nsecond line",
      "book": {
        "title": "",
        "premise": "",
        "chapters": [
          {
            "id": "ch_1",
            "title": "Chapter 1",
            "setting_id": "",
            "paragraphs": [
              "one line",
              "second line"
            ]
          }
        ]
      },
      "setting_names": {},
      "text_out": "Chapter 1: Chapter 1\n\none line\n\nsecond line"
    },
    {
      "name": "a sentence that starts with Chapter is not a heading",
      "text": "Chapter 1\nChapter by chapter she read the letters.",
      "book": {
        "title": "",
        "premise": "",
        "chapters": [
          {
            "id": "ch_1",
            "title": "Chapter 1",
            "setting_id": "",
            "paragraphs": [
              "Chapter by chapter she read the letters."
            ]
          }
        ]
      },
      "setting_names": {},
      "text_out": "Chapter 1: Chapter 1\n\nChapter by chapter she read the letters."
    }
  ],
